{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "python",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "args": [
        "-B",
        "${workspaceFolder}/Rehab/scripts/project.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "flash - ST-Link",
      "type": "process",
      "command": "python",
      "problemMatcher": [],
      "args": [
        "-B",
        "${workspaceFolder}/Rehab/scripts/project.py",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "original board only: flash - Black Magic Probe",
      "type": "process",
      "command": "make",
      "problemMatcher": [],
      "args": [
        "-f",
        "Makefile",
        "flash-bmp"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "openocd",
      "type": "shell",
      "command": "openocd -f \"interface/stlink-v2.cfg\" -f \"target/stm32f4x.cfg\" -c \"gdb_port 3333; log_output openocd.log\"",
      "problemMatcher": []
    },
    {
      "label": "rehab: refresh editor context",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${workspaceFolder}/Rehab/scripts/project.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "rehab: flash preflight (no device access)",
      "type": "process",
      "command": "python",
      "args": [
        "-B",
        "${workspaceFolder}/Rehab/scripts/project.py",
        "flash",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
